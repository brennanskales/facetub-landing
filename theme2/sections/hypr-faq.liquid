{%- liquid
  assign s = section.settings
  assign center = s.center
-%}
<section{% if s.anchor != blank %} id="{{ s.anchor }}"{% endif %} class="wrap {{ s.spacing }}"{% if s.narrow %} style="max-width: 920px"{% endif %}>{%- if s.script != blank or s.heading != blank -%}<div class="stitle{% if center %} center{% endif %}">{% if s.script != blank %}<span class="script">{{ s.script }}</span>{% endif %}{% if s.heading != blank %}<h2 class="disp {% if s.small %}faq-h{% else %}h2{% endif %}">{{ s.heading }}</h2>{% endif %}{% if s.text != blank %}<p class="lede">{{ s.text }}</p>{% endif %}</div>{%- endif -%}
<div class="faq"{% if s.narrow %} style="max-width: none"{% endif %}>{%- for block in section.blocks -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<span class="plus">+</span></summary><div class="faq-a">{{ block.settings.answer }}</div></details>{%- endfor -%}</div>
{%- if s.button_label != blank -%}<div style="text-align: center; margin-top: 32px"><a href="{{ s.button_link }}" class="btn btn-line">{{ s.button_label }}</a></div>{%- endif -%}
</section>

{% schema %}
{
  "name": "HYPR FAQ",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Clarity. Included."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good questions."
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Center the title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "small",
      "label": "Smaller heading (FAQ page groups)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Narrow column with left title",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": ""
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "sec",
          "label": "Large"
        },
        {
          "value": "pb",
          "label": "Bottom only"
        },
        {
          "value": "pb-sm",
          "label": "Small"
        }
      ],
      "default": "pb"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (for links like #buy)",
      "default": "faq"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is HYPR?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>One scoop with electrolytes, creatine and collagen.</p>"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "HYPR FAQ"
    }
  ]
}
{% endschema %}
