{%- liquid
  assign s = section.settings
  assign center = false
-%}
<section class="sec" style="background: {{ s.bg }}"><div class="wrap">{%- if s.script != blank or s.heading != blank -%}<div class="stitle{% if center %} center{% endif %}">{% if s.script != blank %}<span class="script">{{ s.script }}</span>{% endif %}{% if s.heading != blank %}<h2 class="disp h2">{{ s.heading }}</h2>{% endif %}{% if s.text != blank %}<p class="lede">{{ s.text }}</p>{% endif %}</div>{%- endif -%}
<div class="uses">{%- for block in section.blocks -%}{%- assign b = block.settings -%}<div class="use" {{ block.shopify_attributes }}>{% if b.image != blank %}<img src="{{ b.image | image_url: width: 600 }}" loading="lazy" alt="{{ b.image.alt | escape }}" style="object-position: {{ b.position }}">{% endif %}<div><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div></div>{%- endfor -%}</div>
</div></section>

{% schema %}
{
  "name": "HYPR use-case cards",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Made for your daily grind"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "An athlete’s background. An everyday mindset."
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "use",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "position",
          "label": "Image focus",
          "default": "50% 50%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The early lift"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "HYPR use-case cards"
    }
  ]
}
{% endschema %}
