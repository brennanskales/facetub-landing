{%- liquid
  assign s = section.settings
-%}
<section class="sec ugc-sec {{ s.style }}"{% if s.anchor != blank %} id="{{ s.anchor }}"{% endif %}>
<div class="wrap social-head">
<div style="display: flex; flex-direction: column; gap: 6px">{% if s.script != blank %}<span class="script" style="font-size: 40px">{{ s.script }}</span>{% endif %}<h2 class="disp h2">{{ s.heading }}</h2></div>
{%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn {% if s.style == 'dark' %}btn-gold{% else %}btn-line{% endif %}">{{ s.button_label }}</a>{%- endif -%}
</div>
<div class="ugc">
{%- for block in section.blocks -%}{%- assign b = block.settings -%}
<figure class="ugc-card" {{ block.shopify_attributes }}>
{%- if block.type == 'video' -%}{%- assign vurl = b.video -%}{%- unless vurl contains '/' -%}{%- assign vurl = vurl | file_url -%}{%- endunless -%}
<video src="{{ vurl }}"{% if b.poster != blank %} poster="{{ b.poster | image_url: width: 700 }}"{% endif %} controls playsinline preload="none"></video>
{%- else -%}{% if b.image != blank %}<img src="{{ b.image | image_url: width: 700 }}" loading="lazy" alt="{{ b.image.alt | escape }}">{% endif %}{%- endif -%}
{%- if b.tag != blank or b.caption != blank -%}<figcaption><b>{{ b.tag }}</b>{{ b.caption }}</figcaption>{%- endif -%}
</figure>
{%- endfor -%}
</div>
</section>

{% schema %}
{
  "name": "HYPR UGC videos",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Real people,"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See HYPR in real life."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "light",
          "label": "Light"
        }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (for links like #buy)"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "text",
          "id": "video",
          "label": "Video (Shopify file name or full URL)",
          "default": "hypr-ugc-1.mp4"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    },
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "HYPR UGC videos"
    }
  ]
}
{% endschema %}
