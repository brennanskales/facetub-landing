{%- liquid
  assign s = section.settings
-%}
<section class="wrap" style="padding-bottom: 72px">
<div class="final">
<div style="display: flex; flex-direction: column; gap: 18px">
{%- if s.script != blank -%}<span class="script" style="font-size: 48px">{{ s.script }}</span>{%- endif -%}
<h2 class="disp" style="font-size: clamp(44px, 6vw, 88px); color: #FFFFFF">{{ s.heading }}</h2>
{%- if s.text != blank -%}<p style="margin: 0; color: #D9D6CE; font-size: 18px; line-height: 1.6; max-width: 460px">{{ s.text }}</p>{%- endif -%}
{%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn btn-gold" style="align-self: flex-start">{{ s.button_label }}</a>{%- endif -%}
</div>
{%- if s.image != blank -%}{{ s.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'final-tub', alt: s.image.alt }}{%- endif -%}
</div>
</section>

{% schema %}
{
  "name": "HYPR closing CTA",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Ready?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make your routine simpler."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Three essentials. One scoop. First order? Get a free HYPR bottle."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product image"
    }
  ],
  "presets": [
    {
      "name": "HYPR closing CTA"
    }
  ]
}
{% endschema %}
