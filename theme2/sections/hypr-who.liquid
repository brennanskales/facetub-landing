{%- liquid
  assign s = section.settings
  assign center = false
-%}
<section class="wrap sec">{%- if s.script != blank or s.heading != blank -%}<div class="stitle{% if center %} center{% endif %}">{% if s.script != blank %}<span class="script">{{ s.script }}</span>{% endif %}{% if s.heading != blank %}<h2 class="disp h2">{{ s.heading }}</h2>{% endif %}{% if s.text != blank %}<p class="lede">{{ s.text }}</p>{% endif %}</div>{%- endif -%}
<div class="who">{%- for block in section.blocks -%}{%- assign b = block.settings -%}
<a href="{{ b.link }}" class="who-card" {{ block.shopify_attributes }}>{% if b.image != blank %}<img src="{{ b.image | image_url: width: 900 }}" loading="lazy" alt="{{ b.image.alt | escape }}" style="object-position: {{ b.position }}">{% endif %}<div class="who-copy"><span class="script">{{ b.script }}</span><h3 class="disp">{{ b.heading }}</h3><span>{{ b.link_label }}</span></div></a>
{%- endfor -%}</div>
</section>

{% schema %}
{
  "name": "HYPR audience cards",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Made for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who HYPR is for."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "position",
          "label": "Image focus",
          "default": "50% 50%"
        },
        {
          "type": "text",
          "id": "script",
          "label": "Script label",
          "default": "Athletes"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Finish as strong as you start."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now →"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "default": "/pages/athletes"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "HYPR audience cards"
    }
  ]
}
{% endschema %}
