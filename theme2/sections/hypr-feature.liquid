{%- liquid
  assign s = section.settings
-%}
<section class="wrap" style="padding-bottom: 96px{% if s.top_space %}; padding-top: 96px{% endif %}">
<div class="feel">
<div class="feel-media{% if s.image_2 != blank %} two{% endif %}" style="background: {{ s.media_bg }}">
{%- if s.image != blank -%}<img src="{{ s.image | image_url: width: 1400 }}" loading="lazy" alt="{{ s.image.alt | escape }}" style="object-position: {{ s.position }}; object-fit: {{ s.fit }}">{%- endif -%}
{%- if s.image_2 != blank -%}<img src="{{ s.image_2 | image_url: width: 900 }}" loading="lazy" alt="{{ s.image_2.alt | escape }}" style="object-fit: contain; background: #000000">{%- endif -%}
{%- for block in section.blocks -%}{%- if block.type == 'pin' -%}<span class="pin pin-{{ block.settings.spot }}" {{ block.shopify_attributes }}><i></i>{{ block.settings.label }}</span>{%- endif -%}{%- endfor -%}
</div>
<div class="feel-copy">
{%- if s.script != blank -%}<span class="script" style="font-size: 44px">{{ s.script }}</span>{%- endif -%}
<h2 class="disp h2">{{ s.heading }}</h2>
{%- if s.text != blank -%}<p class="lede">{{ s.text }}</p>{%- endif -%}
{%- assign has_checks = false -%}{%- for block in section.blocks -%}{%- if block.type == 'check' -%}{%- assign has_checks = true -%}{%- endif -%}{%- endfor -%}
{%- if has_checks -%}<ul class="checks">{%- for block in section.blocks -%}{%- if block.type == 'check' -%}<li {{ block.shopify_attributes }}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#C9A13B" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>{{ block.settings.text }}</li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}
{%- if s.signature != blank -%}<p style="margin: 0; font-family: 'Caveat', cursive; font-size: 30px; color: #8C6614">{{ s.signature }}</p>{%- endif -%}
{%- if s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn btn-dark" style="align-self: flex-start">{{ s.button_label }}</a>{%- endif -%}
</div>
</div>
</section>

{% schema %}
{
  "name": "HYPR lifestyle feature",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "position",
      "label": "Image focus",
      "default": "50% 50%"
    },
    {
      "type": "select",
      "id": "fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill"
        },
        {
          "value": "contain",
          "label": "Fit whole image"
        }
      ],
      "default": "cover"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image (optional)"
    },
    {
      "type": "color",
      "id": "media_bg",
      "label": "Image background",
      "default": "#0E0E0C"
    },
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature line",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "top_space",
      "label": "Add space above",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "pin",
      "name": "Image pin",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Electrolytes"
        },
        {
          "type": "select",
          "id": "spot",
          "label": "Position",
          "options": [
            {
              "value": "tl",
              "label": "Top left"
            },
            {
              "value": "mr",
              "label": "Middle right"
            },
            {
              "value": "bl",
              "label": "Bottom left"
            },
            {
              "value": "tr",
              "label": "Top right"
            },
            {
              "value": "br",
              "label": "Bottom right"
            }
          ],
          "default": "tl"
        }
      ]
    },
    {
      "type": "check",
      "name": "Checklist item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Puts back the salt you sweat out"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "HYPR lifestyle feature"
    }
  ]
}
{% endschema %}
