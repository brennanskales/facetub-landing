{%- liquid
  assign s = section.settings
  assign center = false
-%}
<section class="wrap {{ s.spacing }}">{%- if s.script != blank or s.heading != blank -%}<div class="stitle{% if center %} center{% endif %}">{% if s.script != blank %}<span class="script">{{ s.script }}</span>{% endif %}{% if s.heading != blank %}<h2 class="disp h2">{{ s.heading }}</h2>{% endif %}{% if s.text != blank %}<p class="lede">{{ s.text }}</p>{% endif %}</div>{%- endif -%}
<div class="steps">{%- for block in section.blocks -%}{%- assign b = block.settings -%}<div class="step" {{ block.shopify_attributes }}><div class="step-img">{% if b.image != blank %}<img src="{{ b.image | image_url: width: 700 }}" loading="lazy" alt="{{ b.image.alt | escape }}">{% endif %}</div><div class="step-body"><span class="step-n">{{ b.number }}</span><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div></div>{%- endfor -%}</div>
</section>

{% schema %}
{
  "name": "HYPR how-to steps",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "A little ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Scoop. Mix. Repeat."
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "sec",
          "label": "Large"
        },
        {
          "value": "pb",
          "label": "Bottom only"
        }
      ],
      "default": "sec"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Scoop"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "One level scoop."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "HYPR how-to steps"
    }
  ]
}
{% endschema %}
