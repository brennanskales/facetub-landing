{%- liquid
  assign s = section.settings
  assign center = false
-%}
<section{% if s.anchor != blank %} id="{{ s.anchor }}"{% endif %} class="wrap" style="padding-bottom: 96px">{%- if s.script != blank or s.heading != blank -%}<div class="stitle{% if center %} center{% endif %}">{% if s.script != blank %}<span class="script">{{ s.script }}</span>{% endif %}{% if s.heading != blank %}<h2 class="disp h2">{{ s.heading }}</h2>{% endif %}{% if s.text != blank %}<p class="lede">{{ s.text }}</p>{% endif %}</div>{%- endif -%}
<ol class="goals">{%- for block in section.blocks -%}<li {{ block.shopify_attributes }}><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></li>{%- endfor -%}</ol>
</section>

{% schema %}
{
  "name": "HYPR numbered list",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Why we created HYPR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make the routine easier to keep."
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (for links like #buy)",
      "default": "why"
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Simplify the daily routine."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "HYPR numbered list"
    }
  ]
}
{% endschema %}
