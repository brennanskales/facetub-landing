{%- liquid
  assign s = section.settings
-%}
<section class="wrap {{ s.spacing }}"{% if s.anchor != blank %} id="{{ s.anchor }}"{% endif %}>
<div class="intro">
<div style="display: flex; flex-direction: column; gap: 6px">
{%- if s.script != blank -%}<span class="script" style="font-size: 40px">{{ s.script }}</span>{%- endif -%}
<h2 class="disp h2">{{ s.heading }}</h2>
{%- if s.side_text != blank -%}<p class="lede" style="margin-top: 20px; max-width: 420px">{{ s.side_text }}</p>{%- endif -%}
{%- if section.blocks.size > 0 and s.button_label != blank -%}<a href="{{ s.button_link }}" class="btn btn-dark" style="align-self: flex-start; margin-top: 20px">{{ s.button_label }}</a>{%- endif -%}
</div>
{%- if section.blocks.size > 0 -%}
<div class="math">
<p class="eyebrow" style="color: #D4AF4A">{{ s.math_eyebrow }}</p>
{%- for block in section.blocks -%}<div class="math-row" {{ block.shopify_attributes }}><span>{{ block.settings.label }}</span><b>{{ block.settings.value }}</b></div>{%- endfor -%}
<div class="math-total"><span style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 14px; color: #D9D6CE">{{ s.total_label }}</span><s>{{ s.total_old }}</s></span><b>{{ s.total_new }}</b></div>
{%- if s.math_note != blank -%}<p style="margin: 0; font-size: 12px; color: #9A978E">{{ s.math_note }}</p>{%- endif -%}
</div>
{%- else -%}
<div style="display: flex; flex-direction: column; gap: 28px">
<p class="intro-text">{{ s.statement }}</p>
{%- if s.button_label != blank or s.button2_label != blank -%}<div style="display: flex; flex-wrap: wrap; gap: 12px">{% if s.button_label != blank %}<a href="{{ s.button_link }}" class="btn btn-dark">{{ s.button_label }}</a>{% endif %}{% if s.button2_label != blank %}<a href="{{ s.button2_link }}" class="btn btn-line">{{ s.button2_label }}</a>{% endif %}</div>{%- endif -%}
</div>
{%- endif -%}
</div>
</section>

{% schema %}
{
  "name": "HYPR intro statement",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": ""
    },
    {
      "type": "inline_richtext",
      "id": "side_text",
      "label": "Text under heading",
      "default": ""
    },
    {
      "type": "inline_richtext",
      "id": "statement",
      "label": "Big statement (italic text shows grey)",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": ""
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": ""
    },
    {
      "type": "text",
      "id": "button2_label",
      "label": "Second button label",
      "default": ""
    },
    {
      "type": "text",
      "id": "button2_link",
      "label": "Second button link",
      "default": ""
    },
    {
      "type": "header",
      "content": "Price box (shows when you add price rows)"
    },
    {
      "type": "text",
      "id": "math_eyebrow",
      "label": "Price box eyebrow",
      "default": "Three separate tubs"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "One tub of HYPR"
    },
    {
      "type": "text",
      "id": "total_old",
      "label": "Old total",
      "default": "$115"
    },
    {
      "type": "text",
      "id": "total_new",
      "label": "New price",
      "default": "$49.99"
    },
    {
      "type": "text",
      "id": "math_note",
      "label": "Footnote",
      "default": ""
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "sec",
          "label": "Large"
        },
        {
          "value": "pb",
          "label": "Bottom only"
        }
      ],
      "default": "sec"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (for links like #buy)",
      "default": ""
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Price row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Electrolytes"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Price",
          "default": "$45"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "HYPR intro statement"
    }
  ]
}
{% endschema %}
