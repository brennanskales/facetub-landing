{%- liquid
  assign s = section.settings
  assign center = false
-%}
<section class="wrap" style="padding-bottom: 96px">{%- if s.script != blank or s.heading != blank -%}<div class="stitle{% if center %} center{% endif %}">{% if s.script != blank %}<span class="script">{{ s.script }}</span>{% endif %}{% if s.heading != blank %}<h2 class="disp h2">{{ s.heading }}</h2>{% endif %}{% if s.text != blank %}<p class="lede">{{ s.text }}</p>{% endif %}</div>{%- endif -%}
<div class="pillars">{%- for block in section.blocks -%}{%- assign b = block.settings -%}<div class="pillar" {{ block.shopify_attributes }}><p class="eyebrow">{{ b.eyebrow }}</p><b>{{ b.value }}</b><h3>{{ b.title }}</h3><p>{{ b.text }}</p></div>{%- endfor -%}</div>
</section>

{% schema %}
{
  "name": "HYPR three pillars",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "One scoop,"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three jobs."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "01 · Hydrate"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Big number",
          "default": "810 mg"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Electrolytes"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "HYPR three pillars"
    }
  ]
}
{% endschema %}
