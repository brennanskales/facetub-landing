{%- liquid
  assign s = section.settings
-%}
<section class="wrap {{ s.spacing }}">
<div class="honest">
<div style="display: flex; flex-direction: column; gap: 6px">{% if s.script != blank %}<span class="script" style="font-size: 44px">{{ s.script }}</span>{% endif %}<h2 class="disp h2" style="color: #FFFFFF">{{ s.heading }}</h2></div>
<div style="display: flex; flex-direction: column; gap: 16px">{{ s.text }}{% if s.button_label != blank %}<a href="{{ s.button_link }}" class="btn btn-gold" style="align-self: flex-start">{{ s.button_label }}</a>{% endif %}</div>
</div>
</section>

{% schema %}
{
  "name": "HYPR dark callout",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Straight talk,"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Is the blend better?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>No study shows that.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "sec",
          "label": "Large"
        },
        {
          "value": "pb",
          "label": "Bottom only"
        }
      ],
      "default": "sec"
    }
  ],
  "presets": [
    {
      "name": "HYPR dark callout"
    }
  ]
}
{% endschema %}
