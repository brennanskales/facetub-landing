{%- liquid
  assign s = section.settings
  assign center = false
-%}
<section{% if s.anchor != blank %} id="{{ s.anchor }}"{% endif %} class="wrap {{ s.spacing }}">{%- if s.script != blank or s.heading != blank -%}<div class="stitle{% if center %} center{% endif %}">{% if s.script != blank %}<span class="script">{{ s.script }}</span>{% endif %}{% if s.heading != blank %}<h2 class="disp h2">{{ s.heading }}</h2>{% endif %}{% if s.text != blank %}<p class="lede">{{ s.text }}</p>{% endif %}</div>{%- endif -%}
<div class="cmp-box"><table class="cmp">
<thead><tr><th>{{ s.col0 }}</th><th class="us">{% if s.logo != blank %}{{ s.logo | image_url: width: 200 | image_tag: alt: s.col1, style: 'height: 22px; width: auto; margin: 0 auto' }}{% else %}{{ s.col1 }}{% endif %}</th>{% if s.col2 != blank %}<th>{{ s.col2 }}</th>{% endif %}{% if s.col3 != blank %}<th>{{ s.col3 }}</th>{% endif %}{% if s.col4 != blank %}<th>{{ s.col4 }}</th>{% endif %}</tr></thead>
<tbody>{%- for block in section.blocks -%}{%- assign b = block.settings -%}<tr {{ block.shopify_attributes }}><td>{{ b.label }}</td><td class="us">{{ b.v1 }}</td>{% if s.col2 != blank %}<td>{{ b.v2 }}</td>{% endif %}{% if s.col3 != blank %}<td>{{ b.v3 }}</td>{% endif %}{% if s.col4 != blank %}<td>{{ b.v4 }}</td>{% endif %}</tr>{%- endfor -%}</tbody>
</table></div>
{%- if s.note != blank -%}<p style="margin: 14px 0 0; font-size: 12px; color: #9A978E">{{ s.note }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "HYPR comparison table",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "script",
      "label": "Script accent",
      "default": "Compare"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The only one with all three."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "default": "Most hydration mixes stop at salt. Some add sugar. HYPR adds creatine and collagen, with no sugar."
    },
    {
      "type": "text",
      "id": "col0",
      "label": "First column title",
      "default": "Per scoop"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "HYPR column logo (light)"
    },
    {
      "type": "text",
      "id": "col1",
      "label": "HYPR column title",
      "default": "HYPR"
    },
    {
      "type": "text",
      "id": "col2",
      "label": "Column 2",
      "default": "LMNT"
    },
    {
      "type": "text",
      "id": "col3",
      "label": "Column 3",
      "default": "Liquid I.V."
    },
    {
      "type": "text",
      "id": "col4",
      "label": "Column 4",
      "default": "Create Creatine + Electrolytes"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Footnote",
      "default": ""
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "options": [
        {
          "value": "sec",
          "label": "Large"
        },
        {
          "value": "pb",
          "label": "Bottom only"
        }
      ],
      "default": "pb"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (for links like #buy)",
      "default": "compare"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Sodium"
        },
        {
          "type": "text",
          "id": "v1",
          "label": "HYPR",
          "default": "810 mg"
        },
        {
          "type": "text",
          "id": "v2",
          "label": "Column 2",
          "default": ""
        },
        {
          "type": "text",
          "id": "v3",
          "label": "Column 3",
          "default": ""
        },
        {
          "type": "text",
          "id": "v4",
          "label": "Column 4",
          "default": ""
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "HYPR comparison table"
    }
  ]
}
{% endschema %}
