<section class="wrap" style="padding-bottom: 96px{% if section.settings.top_space %}; padding-top: 96px{% endif %}">
<div class="stats">{%- for block in section.blocks -%}<div class="stat" {{ block.shopify_attributes }}><b>{{ block.settings.value }}</b><span>{{ block.settings.label }}</span></div>{%- endfor -%}</div>
{%- if section.settings.note != blank -%}<p style="margin: 20px 0 0; text-align: center; font-size: 12px; color: #9A978E">{{ section.settings.note }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "HYPR big stats",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "note",
      "label": "Footnote"
    },
    {
      "type": "checkbox",
      "id": "top_space",
      "label": "Add space above",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "default": "0 g"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Sugar in every scoop"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "HYPR big stats"
    }
  ]
}
{% endschema %}
