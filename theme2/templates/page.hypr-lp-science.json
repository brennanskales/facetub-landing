    "faq_12": {
      "type": "hypr-faq",
      "settings": {
        "script": "Myth vs. fact",
        "heading": "The questions everyone Googles.",
        "center": true,
        "small": false,
        "narrow": false,
        "button_label": "",
        "button_link": "",
        "spacing": "pb",
        "anchor": "faq"
      },
      "blocks": {
        "question_491": {
          "type": "question",
          "settings": {
            "question": "Will creatine make my hair fall out?",
            "answer": "<p>This myth comes from one small 2009 study. It found a hormone change, but it never measured hair. Later studies have not shown that creatine causes hair loss [2].</p>"
          }
        },
        "question_492": {
          "type": "question",
          "settings": {
            "question": "Is creatine bad for your kidneys?",
            "answer": "<p>In healthy people, normal doses have not been shown to harm the kidneys [1][2]. If you have kidney problems, talk to your doctor before taking it.</p>"
          }
        },
        "question_493": {
          "type": "question",
          "settings": {
            "question": "Does creatine cause cramps or dehydration?",
            "answer": "<p>No. Research does not back that up [2]. HYPR pairs creatine with 810 mg of sodium plus potassium and magnesium, so your electrolytes come in the same drink.</p>"
          }
        },
        "question_494": {
          "type": "question",
          "settings": {
            "question": "Do I need to “load” creatine?",
            "answer": "<p>No. Loading gets you there faster, but a steady 3–5 g a day fills your muscles in a few weeks [1]. HYPR’s 5 g scoop is built for that.</p>"
          }
        },
