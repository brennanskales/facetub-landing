      "blocks": {
        "question_327": {
          "type": "question",
          "settings": {
            "question": "Is creatine safe for my teen?",
            "answer": "<p>Creatine is one of the most studied sports supplements there is. A 2026 guide for pediatricians says 3–5 g a day can be reasonable for teens who train hard, eat enough and have no kidney problems. Every kid is different, so talk with your athlete’s doctor first. HYPR is labeled for [AGE GUIDANCE FROM LABEL].</p>"
          }
        },
        "question_328": {
          "type": "question",
          "settings": {
            "question": "Does my kid even need electrolytes?",
            "answer": "<p>For a short practice, water is fine. Electrolytes matter most when it’s hot, when practice runs long, when your kid sweats a lot, or when there’s more than one game in a day. Think tournament weekends.</p>"
          }
        },
        "question_329": {
          "type": "question",
          "settings": {
            "question": "Is there sugar or anything artificial?",
            "answer": "<p>No sugar. No artificial flavors or dyes. HYPR gets its pink color from beet root and its sweetness from stevia.</p>"
          }
        },
        "question_330": {
          "type": "question",
          "settings": {
            "question": "Will they like the taste?",
            "answer": "<p>It’s watermelon. Customers say it mixes smooth, isn’t grainy and isn’t too sweet.</p>"
          }
        },
        "question_331": {
          "type": "question",
          "settings": {
            "question": "Can I pause or cancel the subscription?",
            "answer": "<p>Yes. Subscribe & save ships monthly at 15% off. You can skip, pause or cancel anytime. [CONFIRM SUBSCRIPTION TERMS]</p>"
