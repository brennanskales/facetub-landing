      "blocks": {
        "question_415": {
          "type": "question",
          "settings": {
            "question": "When should I take it?",
            "answer": "<p>Once a day, whenever it fits: before practice, after a lift, on the bus. Creatine works by building up over time, so every day beats perfect timing. Take it on rest days too.</p>"
          }
        },
        "question_416": {
          "type": "question",
          "settings": {
            "question": "Do I still need to drink water?",
            "answer": "<p>Yes. HYPR goes into 16–24 oz of water and adds the salt plain water doesn’t have. Keep drinking through long, hot sessions.</p>"
          }
        },
        "question_417": {
          "type": "question",
          "settings": {
            "question": "Will creatine make me cramp or bloat?",
            "answer": "<p>Research does not show that creatine causes cramps or dehydration. Some people gain a little water weight at first. That water goes into your muscle, not your belly.</p>"
          }
        },
        "question_418": {
          "type": "question",
          "settings": {
            "question": "Why not just drink LMNT or Liquid I.V.?",
            "answer": "<p>They are hydration only. You would still need a creatine tub and a collagen tub. HYPR puts all three in one scoop, with no sugar.</p>"
          }
        },
        "question_419": {
          "type": "question",
          "settings": {
            "question": "Is creatine a steroid?",
            "answer": "<p>No. Your body makes creatine and stores it in muscle. It’s also in meat and fish. HYPR uses creatine monohydrate, the most studied form.</p>"
          }
        },
        "question_420": {
          "type": "question",
          "settings": {
            "question": "How does it taste?",
            "answer": "<p>Watermelon, sweetened with stevia, zero sugar. Customers say it mixes smooth and isn’t grainy.</p>"
          }
        }
      },
