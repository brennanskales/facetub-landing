{% layout none %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#F7F6F2">
<title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
{%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{% endif %}
{{ content_for_header }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,700..900&amp;family=Caveat:wght@700&amp;family=Instrument+Sans:wght@400;500;600;700&amp;display=swap">
<style>
body{margin:0;background:#F7F6F2;color:#0E0E0C;font-family:'Instrument Sans','Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased}
*{box-sizing:border-box}
a{color:#0E0E0C}a:hover{color:#8C6614}
img{max-width:100%;display:block}
.wrap{max-width:1320px;margin:0 auto;padding-left:20px;padding-right:20px}
.sec{padding-top:96px;padding-bottom:96px}
.disp{font-family:'Archivo','Helvetica Neue',Arial,sans-serif;font-weight:800;font-stretch:82%;text-transform:uppercase;letter-spacing:-0.015em;line-height:0.92;margin:0;text-wrap:balance}
.h2{font-size:clamp(40px,5.2vw,72px)}
.script{font-family:'Caveat','Brush Script MT',cursive;font-weight:700;color:#C9A13B;text-transform:none;letter-spacing:0;display:block;transform:rotate(-5deg);transform-origin:left bottom;line-height:1}
.eyebrow{font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8C6614;margin:0}
.lede{font-size:18px;line-height:1.6;color:#5E5C55;margin:0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:14px 26px;border-radius:999px;font-weight:700;font-size:16px;text-decoration:none;border:0;cursor:pointer;font-family:inherit;transition:transform .15s ease}
.btn:hover{transform:translateY(-1px)}
.btn-gold{background:#C9A13B;color:#0E0E0C}.btn-gold:hover{color:#0E0E0C}
.btn-dark{background:#0E0E0C;color:#FFFFFF}.btn-dark:hover{color:#FFFFFF}
.btn-line{background:transparent;color:#0E0E0C;border:1.5px solid #0E0E0C}
.stars{color:#C9A13B;letter-spacing:2px}
.marquee{background:#0E0E0C;color:#FFFFFF;overflow:hidden;white-space:nowrap;font-size:13px;font-weight:600}
.marquee-track{display:inline-flex;gap:44px;padding:10px 22px;animation:mq 36s linear infinite}
.marquee-track span::before{content:"✦";color:#C9A13B;margin-right:12px}
@keyframes mq{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.nav{position:sticky;top:0;z-index:40;background:rgba(247,246,242,0.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.nav-in{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:12px;padding-bottom:12px}
.nav-links{display:flex;gap:28px;font-size:15px;font-weight:600}
.nav-links a{text-decoration:none;color:#5E5C55}
.hero{position:relative;border-radius:28px;overflow:hidden;background:#0E0E0C;color:#FFFFFF;min-height:700px;display:flex}
.hero-media{position:absolute;top:0;right:0;bottom:0;width:64%}
.hero-media img{width:100%;height:100%;object-fit:cover;object-position:var(--pos,50% 50%);-webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 32%);mask-image:linear-gradient(90deg,transparent 0%,#000 32%)}
.hero-copy{position:relative;z-index:2;width:min(620px,56%);padding:56px 0 48px 56px;display:flex;flex-direction:column;justify-content:space-between;gap:36px}
.hero-h1{font-size:clamp(56px,6.6vw,100px);color:#FFFFFF}
.hero-h1 .script{font-size:0.6em;color:#D4AF4A;margin-bottom:0.08em}
.hero-sub{font-size:18px;line-height:1.55;color:#D9D6CE;max-width:460px;margin:0}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;align-items:center}
.hero-link{color:#FFFFFF;font-weight:700;text-underline-offset:4px}
.hero-link:hover{color:#D4AF4A}
.hero-proof{display:flex;flex-wrap:wrap;align-items:center;gap:8px 14px;font-size:14px;color:#D9D6CE}
.offer-pill{display:inline-flex;align-items:center;gap:12px;align-self:flex-start;max-width:100%;border:1.5px solid #C9A13B;border-radius:999px;padding:6px 18px 6px 6px;font-size:15px;color:#FFFFFF}
.offer-pill img{width:40px;height:40px;border-radius:50%;object-fit:cover;object-position:50% 45%;flex:none}
.offer-pill b{color:#D4AF4A}
.hero-card{position:absolute;z-index:3;top:24px;right:24px;width:236px;background:#FFFFFF;color:#0E0E0C;border-radius:20px;padding:12px 16px 12px 12px;display:flex;gap:12px;align-items:center;text-decoration:none;box-shadow:0 18px 40px rgba(0,0,0,0.25)}
.hero-card img{width:58px;height:auto;flex:none}
.hero-card small{display:block;font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8C6614}
.hero-card b{display:block;font-size:15px;line-height:1.25}
.hero-card span{display:block;font-size:13px;color:#5E5C55;margin-top:2px}
.hero-stats{position:absolute;z-index:3;right:24px;bottom:24px;display:flex;flex-direction:column;gap:8px}
.stat-chip{background:rgba(14,14,12,0.58);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,0.18);border-radius:14px;padding:10px 14px;min-width:168px;display:flex;justify-content:space-between;align-items:baseline;gap:16px;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#D9D6CE}
.stat-chip b{font-size:20px;letter-spacing:0;color:#FFFFFF;text-transform:none}
.intro{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:56px;align-items:start}
.intro-text{font-size:clamp(22px,2.3vw,32px);line-height:1.45;font-weight:500;margin:0;color:#0E0E0C}
.intro-text .muted{color:#9A978E}
.pill-img{display:inline-block;width:84px;height:40px;border-radius:999px;object-fit:cover;vertical-align:middle;margin:0 4px}
.pdp{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:56px;align-items:start}
.pdp-main{position:relative;aspect-ratio:1/1;max-width:100%;border-radius:24px;overflow:hidden;background:#EDEAE2}
.pdp-main img{width:100%;height:100%;object-fit:cover}
.pdp-badge{position:absolute;left:16px;top:16px;background:#0E0E0C;color:#FFFFFF;border-radius:999px;padding:8px 14px;font-size:13px;font-weight:700}
.pdp-badge b{color:#D4AF4A}
.pdp-thumbs{display:flex;gap:10px;margin-top:12px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.pdp-thumbs button img{width:100%;height:100%;object-fit:cover;border-radius:10px}
.acc{margin-top:20px;display:flex;flex-direction:column;gap:10px}
.acc details{background:#FFFFFF;border:1px solid #E6E3DB;border-radius:16px;padding:0 18px}
.acc summary{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:56px;font-weight:700;cursor:pointer;list-style:none}
.acc summary::-webkit-details-marker{display:none}
.acc .plus{font-size:22px;transition:transform .2s}
.acc details[open] .plus{transform:rotate(45deg)}
.acc p,.acc ul{margin:0 0 18px;color:#5E5C55;line-height:1.6;font-size:15px}
.pdp-info{display:flex;flex-direction:column;gap:18px;position:sticky;top:86px}
.pdp-title{font-size:clamp(36px,3.6vw,52px)}
.rating{display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;font-size:14px;color:#5E5C55}
.bens{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 18px;margin:0;padding:0;list-style:none;font-size:15px;font-weight:600}
.bens li{display:flex;gap:10px;align-items:flex-start}
.bens svg{flex:none;margin-top:1px}
.plan-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:16px 18px 12px;width:100%;text-align:left}
.plan-top b{font-size:17px;display:block}
.plan-top small{display:block;font-size:13px;color:#5E5C55;margin-top:4px}
.plan-price{text-align:right;flex:none}
.plan-price b{font-size:22px}
.plan-price s{display:block;font-size:13px;color:#9A978E}
.plan-gift{display:flex;align-items:center;gap:8px;width:100%;padding:10px 18px;background:#F3EBD6;font-size:14px;font-weight:600;color:#0E0E0C;text-align:left}
.plan-badge{display:inline-block;vertical-align:2px;margin-left:6px;background:#C9A13B;color:#0E0E0C;border-radius:999px;padding:3px 9px;font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase}
.trust{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 20px;font-size:13px;color:#5E5C55}
.trust span{display:inline-flex;align-items:center;gap:6px}
.feel{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);background:#FFFFFF;border-radius:28px;overflow:hidden}
.feel-media{position:relative;min-height:560px}
.feel-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.pin{position:absolute;display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.94);color:#0E0E0C;border-radius:999px;padding:7px 14px 7px 8px;font-size:13px;font-weight:700;box-shadow:0 8px 24px rgba(0,0,0,0.15)}
.pin i{width:12px;height:12px;border-radius:50%;background:#C9A13B;box-shadow:0 0 0 4px rgba(201,161,59,0.3)}
.feel-copy{padding:64px 56px;display:flex;flex-direction:column;justify-content:center;gap:22px}
.checks{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;font-size:16px}
.checks li{display:flex;gap:12px;align-items:flex-start}
.checks svg{flex:none;margin-top:2px}
.swap{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.swap-card{border-radius:24px;padding:32px;display:flex;flex-direction:column;gap:14px}
.swap-row{display:flex;justify-content:space-between;gap:12px;padding-bottom:12px;font-size:17px}
.ingr-head{text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;max-width:720px;margin:0 auto 48px}
.ingr-head .script{transform-origin:center;font-size:44px}
.ingr{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid #E6E3DB;border-left:1px solid #E6E3DB}
.ing{border-right:1px solid #E6E3DB;border-bottom:1px solid #E6E3DB;padding:36px 28px;display:flex;flex-direction:column;align-items:center;text-align:center;gap:10px}
.ing img,.ing .sym{width:120px;height:120px;border-radius:50%;object-fit:cover}
.ing .sym{background:#0E0E0C;color:#D4AF4A;display:flex;align-items:center;justify-content:center;font-family:'Archivo',Arial,sans-serif;font-weight:800;font-size:44px}
.ing h3{margin:6px 0 0;font-size:20px}
.ing .dose{font-weight:700;color:#8C6614;font-size:14px}
.ing p{margin:0;color:#5E5C55;font-size:15px;line-height:1.5;max-width:280px}
.social-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:28px}
.strip{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-left:max(20px,calc((100% - 1280px)/2));padding-right:20px}
.strip::-webkit-scrollbar{display:none}
.tile{flex:none;width:260px;aspect-ratio:4/5;border-radius:20px;overflow:hidden;position:relative;background:#0E0E0C;scroll-snap-align:start;margin:0}
.tile img,.tile video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));text-align:center}
.stat{padding:12px 24px;display:flex;flex-direction:column;align-items:center;gap:10px}
.stat + .stat{border-left:1px solid #E6E3DB}
.stat b{font-family:'Archivo',Arial,sans-serif;font-weight:800;font-stretch:82%;font-size:clamp(64px,8vw,120px);line-height:0.9;letter-spacing:-0.02em}
.stat span{font-size:15px;color:#5E5C55;max-width:240px}
.rev-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px}
.rev{flex:none;width:320px;background:#FFFFFF;border:1px solid #E6E3DB;border-radius:22px;overflow:hidden;display:flex;flex-direction:column;scroll-snap-align:start;margin:0}
.rev-body{padding:22px;display:flex;flex-direction:column;gap:12px;flex:1}
.rev-top{display:flex;justify-content:space-between;gap:10px;font-size:14px}
.rev blockquote{margin:0;font-size:16px;line-height:1.5}
.rev-prod{background:#F1EEE7;height:150px;display:flex;align-items:center;justify-content:center}
.rev-prod img{height:120px;width:auto}
.wall{columns:3 280px;column-gap:14px}
.faq{max-width:880px;margin:0 auto}
.faq details{border-bottom:1px solid #DCD8CE}
.faq summary{display:flex;justify-content:space-between;align-items:center;gap:16px;min-height:72px;font-size:19px;font-weight:700;cursor:pointer;list-style:none}
.faq summary::-webkit-details-marker{display:none}
.faq .plus{font-size:26px;transition:transform .2s;flex:none}
.faq details[open] .plus{transform:rotate(45deg)}
.faq p{margin:0 0 22px;color:#5E5C55;line-height:1.65;font-size:16px}
.final{background:#0E0E0C;color:#FFFFFF;border-radius:28px;padding:72px 56px;display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:40px;align-items:center;overflow:hidden;position:relative}
.final img.final-tub{width:min(300px,100%);justify-self:center;filter:drop-shadow(0 30px 40px rgba(201,161,59,0.25))}
.foot{display:flex;flex-wrap:wrap;justify-content:space-between;gap:28px;padding-top:48px;padding-bottom:120px;font-size:14px;color:#5E5C55}
.foot a{color:#5E5C55;text-decoration:none}
.foot-links{display:flex;flex-wrap:wrap;gap:12px 28px}
.mbar{display:none}
@media (max-width:900px){
.nav-links{display:none}
.intro,.pdp,.feel,.final{grid-template-columns:minmax(0,1fr)}
.pdp-info{position:static}
.feel-media{min-height:420px}
.feel-copy{padding:36px 24px}
.ingr{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media (max-width:760px){
.sec{padding-top:56px;padding-bottom:56px}
.marquee{font-size:12px}
.hero-wrap{padding-left:10px;padding-right:10px}
.hero{flex-direction:column;min-height:0;border-radius:22px}
.hero-media{position:relative;width:100%;aspect-ratio:4/5;max-width:100%}
.hero-media img{object-position:var(--mpos,50% 50%);-webkit-mask-image:linear-gradient(180deg,#000 70%,transparent 100%);mask-image:linear-gradient(180deg,#000 70%,transparent 100%)}
.hero-copy{width:100%;padding:0 18px 26px;margin-top:-84px;gap:20px}
.hero-h1{font-size:clamp(40px,11.4vw,58px)}
.hero-sub{font-size:16px}
.hero-cta .btn{width:100%}
.hero-link{display:none}
.hero-card{display:none}
.hero-stats{top:12px;right:12px;bottom:auto;gap:6px}
.stat-chip{min-width:0;padding:7px 10px;font-size:10px;gap:10px}
.stat-chip b{font-size:14px}
.intro-text{font-size:21px}
.pill-img{width:60px;height:30px}
.bens{grid-template-columns:minmax(0,1fr)}
.swap{grid-template-columns:minmax(0,1fr)}
.swap-card{padding:24px}
.ingr{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.ing{padding:24px 12px}
.ing img,.ing .sym{width:88px;height:88px}
.ing .sym{font-size:32px}
.ing p{font-size:13px}
.tile{width:68vw}
.rev{width:82vw}
.stats{grid-template-columns:minmax(0,1fr)}
.stat + .stat{border-left:0;border-top:1px solid #E6E3DB;padding-top:24px}
.wall{columns:1}
.wall figure:nth-child(n+7){display:none}
.faq summary{font-size:17px}
.final{padding:44px 22px;border-radius:22px}
.mbar{display:flex;position:sticky;bottom:0;z-index:50;background:rgba(14,14,12,0.96);color:#FFFFFF;padding:10px 14px;align-items:center;justify-content:space-between;gap:12px}
.mbar .btn{white-space:nowrap;flex:none;min-height:48px;padding:10px 22px}
}
@media (max-width:760px){
.sec{padding-top:44px;padding-bottom:44px}
.h2{font-size:clamp(32px,9vw,40px)}
section .script{font-size:30px !important}
.hero-media{aspect-ratio:1/1}
.hero-copy{margin-top:-64px;gap:16px}
.hero-copy > div{gap:14px !important}
.hero-cta{order:-1}
.hero-sub{font-size:15px}
.hero-proof{font-size:13px}
.offer-pill{font-size:13px;padding:4px 14px 4px 4px}
.offer-pill img{width:32px;height:32px}
.intro{gap:18px}
.intro-text{font-size:19px}
.pdp{display:flex;flex-direction:column;gap:16px}
.pdp > div:first-child{display:contents}
.pdp-main{order:1}
.pdp-thumbs{order:2;margin-top:-4px}
.pdp-info{order:3;gap:14px}
.acc{order:4;margin-top:0;width:100%;align-self:stretch}
.pdp-thumbs button{width:60px !important;height:60px !important}
.pdp-title{font-size:34px}
.bens{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 12px;font-size:13px}
.plan-top{padding:14px 14px 10px}
.plan-top b{font-size:16px}
.plan-gift{padding:8px 14px;font-size:13px}
.feel-media{min-height:320px}
.feel-copy{gap:16px}
.swap-card{padding:20px;gap:8px}
.swap-row{font-size:15px;padding-bottom:8px}
.ingr-head{margin-bottom:24px}
.ingr{grid-template-columns:minmax(0,1fr);border-left:0}
.ing{display:grid;grid-template-columns:64px minmax(0,1fr);column-gap:14px;row-gap:2px;text-align:left;align-items:start;padding:14px 0;border-right:0}
.ing img,.ing .sym{grid-row:1 / span 3;width:64px;height:64px;align-self:center}
.ing .sym{font-size:24px}
.ing h3{margin:0;font-size:16px}
.ing p{font-size:13px;max-width:none}
.stats{grid-template-columns:repeat(3,minmax(0,1fr))}
.stat{padding:4px 6px;gap:6px}
.stat + .stat{border-left:1px solid #E6E3DB;border-top:0;padding-top:4px}
.stat b{font-size:clamp(28px,8.6vw,38px)}
.stat span{font-size:12px}
.rev-head .btn{display:none}
.rev-prod{height:90px}
.rev-prod img{height:72px}
.final{gap:20px}
.final img.final-tub{width:150px}
}
@media (prefers-reduced-motion: reduce){.marquee-track{animation:none}.btn{transition:none}}
</style>
<style>:root{color-scheme:light}html{scroll-behavior:smooth}body{background:#F7F6F2;overflow-x:hidden}img{max-width:100%}button:focus-visible,a:focus-visible{outline:3px solid #B8912E;outline-offset:3px}@media (prefers-reduced-motion: reduce){html{scroll-behavior:auto}.ugc-track{transition:none!important}}</style>
</head>
