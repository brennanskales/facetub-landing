<script>
(function(){
  var ON="position: relative; display: flex; flex-direction: column; width: 100%; padding: 0; border-radius: 18px; overflow: hidden; cursor: pointer; font-family: inherit; color: #0E0E0C; background: #FFFFFF; border: 2px solid #C9A13B; box-shadow: 0 10px 30px rgba(201,161,59,0.18);", OFF="position: relative; display: flex; flex-direction: column; width: 100%; padding: 0; border-radius: 18px; overflow: hidden; cursor: pointer; font-family: inherit; color: #0E0E0C; background: #FFFFFF; border: 1.5px solid #E6E3DB;";
  var PRODUCT="https://drinkhypr.com/products/vitamins-and-supplements-example-product-4", CART="https://drinkhypr.com/cart/47081531310255:1";
  function setPlan(p){
    document.querySelectorAll('[data-plan]').forEach(function(b){ b.setAttribute('style', b.getAttribute('data-plan')===p?ON:OFF); b.setAttribute('aria-pressed', b.getAttribute('data-plan')===p); });
    document.querySelectorAll('.js-price').forEach(function(s){ s.textContent = p==='sub' ? '$42.49/mo' : '$49.99'; });
    document.querySelectorAll('.js-buy').forEach(function(a){ a.href = p==='sub' ? PRODUCT : CART; });
  }
  document.querySelectorAll('[data-plan]').forEach(function(b){ b.addEventListener('click', function(){ setPlan(b.getAttribute('data-plan')); }); });
  if (document.querySelector('[data-plan]')) setPlan('sub');
  var track=document.querySelector('.ugc-track'), idx=0;
  function moveUgc(d){
    if(!track) return;
    var n=track.children.length, step=274, vis=Math.max(1, Math.floor(track.parentElement.clientWidth/step));
    idx=Math.min(Math.max(0, idx+d), Math.max(0, n-vis));
    track.style.transform='translateX(-'+(idx*step)+'px)';
  }
  document.querySelectorAll('[data-ugc]').forEach(function(b){ b.addEventListener('click', function(){ moveUgc(b.getAttribute('data-ugc')==='next'?1:-1); }); });
  window.addEventListener('resize', function(){ moveUgc(0); });
  var GON="flex: none; width: 76px; height: 76px; padding: 3px; border-radius: 14px; border: 2px solid #0E0E0C; background: #FFFFFF; cursor: pointer;", GOFF="flex: none; width: 76px; height: 76px; padding: 3px; border-radius: 14px; border: 2px solid transparent; background: #FFFFFF; cursor: pointer;";
  var main=document.getElementById('galMain');
  document.querySelectorAll('[data-pick]').forEach(function(b){ b.addEventListener('click', function(){
    if(main){ main.src=b.getAttribute('data-src'); main.alt=b.getAttribute('data-alt')||''; }
    document.querySelectorAll('[data-pick]').forEach(function(x){ x.setAttribute('style', x===b?GON:GOFF); x.setAttribute('aria-pressed', x===b); });
  }); });
  var ING=null, TON="", TOFF="";
  document.querySelectorAll('[data-tab]').forEach(function(b){ b.addEventListener('click', function(){
    var id=b.getAttribute('data-tab');
    document.querySelectorAll('[data-tab]').forEach(function(x){ var on=x===b; x.setAttribute('style', on?TON:TOFF); x.setAttribute('aria-selected', on); });
    document.querySelectorAll('[data-ing]').forEach(function(s){ s.textContent = ING[id][s.getAttribute('data-ing')]; });
  }); });
})();
</script>
<script>
