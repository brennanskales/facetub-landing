.step-img{aspect-ratio:auto;height:100%}
.step-body{padding:14px 16px}
.step-n{font-size:28px}
.step h3{font-size:18px}
.step p{font-size:14px}
.pillar{padding:20px;display:grid;grid-template-columns:auto minmax(0,1fr);column-gap:18px;row-gap:4px;align-items:center}
.pillar b{font-size:42px;grid-row:1 / span 2}
.pillar p{grid-column:2}
.honest{padding:32px 22px;gap:20px;border-radius:22px}
.honest p{font-size:16px}
.goals li{padding:18px 0;gap:6px 14px}
.goals li::before{font-size:28px}
.goals b{font-size:18px}
.goals span{font-size:15px}
.vs{font-size:14px}
.vs th,.vs td{padding:12px 12px}
.uses{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.use div{padding:12px 14px 16px}
.use h3{font-size:16px}
.use p{font-size:13px}
.shop-grid{grid-template-columns:minmax(0,1fr)}
.form{grid-template-columns:minmax(0,1fr);padding:20px}
.cats{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;margin-bottom:28px}
.cats a{flex:none}
.faq-group{margin-bottom:36px}
.sfoot-top{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 20px;padding-top:48px;padding-bottom:36px}
.sfoot-tag{font-size:17vw}
.drawer{width:100%}
}
.cmp-box{overflow-x:auto;background:#FFFFFF;border:1px solid #E6E3DB;border-radius:24px}
.cmp{width:100%;min-width:720px;border-collapse:collapse;font-size:15px}
.cmp th,.cmp td{padding:16px 18px;text-align:center;border-top:1px solid #EFEBE3}
.cmp thead th{border-top:0;font-size:14px;color:#5E5C55;font-weight:700}
.cmp td:first-child,.cmp th:first-child{text-align:left;font-weight:700;color:#0E0E0C}
.cmp .us{background:#0E0E0C;color:#FFFFFF}
.cmp td.us{background:#FAF6EC;color:#8C6614;font-weight:800}
.ugc{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-left:max(20px,calc((100% - 1280px)/2));padding-right:20px}
.ugc::-webkit-scrollbar{display:none}
.ugc-card{flex:none;width:300px;border-radius:22px;overflow:hidden;background:#0E0E0C;scroll-snap-align:start;margin:0;display:flex;flex-direction:column}
.ugc-card video{width:100%;aspect-ratio:9/16;object-fit:cover;display:block;background:#0E0E0C}
.ugc-card figcaption{padding:14px 16px 16px;color:#FFFFFF;font-size:14px;line-height:1.45}
.ugc-card figcaption b{display:block;color:#D4AF4A;font-size:12px;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:4px}
.proofbar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.proofbar div{background:#FFFFFF;border:1px solid #E6E3DB;border-radius:18px;padding:18px;display:flex;flex-direction:column;gap:4px;text-align:center}
.proofbar b{font-family:'Archivo',Arial,sans-serif;font-weight:800;font-stretch:82%;font-size:36px;line-height:1}
.proofbar span{font-size:13px;color:#5E5C55}
@media (max-width:760px){
.cmp{min-width:600px;font-size:13px}
.cmp th,.cmp td{padding:12px 10px}
.cmp td:first-child,.cmp th:first-child{position:sticky;left:0;background:#FFFFFF;z-index:1}
.ugc-card{width:72vw}
.proofbar{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.proofbar div{padding:14px 10px}
.proofbar b{font-size:28px}
}
</style>
