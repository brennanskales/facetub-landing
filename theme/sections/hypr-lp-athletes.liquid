  document.querySelectorAll('[data-plan]').forEach(function(b){ b.addEventListener('click', function(){ setPlan(b.getAttribute('data-plan')); }); });
  if (document.querySelector('[data-plan]')) setPlan('sub');
  var track=document.querySelector('.ugc-track'), idx=0;
  function moveUgc(d){
    if(!track) return;
    var n=track.children.length, step=274, vis=Math.max(1, Math.floor(track.parentElement.clientWidth/step));
    idx=Math.min(Math.max(0, idx+d), Math.max(0, n-vis));
    track.style.transform='translateX(-'+(idx*step)+'px)';
  }
  document.querySelectorAll('[data-ugc]').forEach(function(b){ b.addEventListener('click', function(){ moveUgc(b.getAttribute('data-ugc')==='next'?1:-1); }); });
  window.addEventListener('resize', function(){ moveUgc(0); });
